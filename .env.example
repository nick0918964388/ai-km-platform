# AI-KM Platform Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# API Keys (Optional - for enhanced features)
# ============================================
OPENAI_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=

# ============================================
# Database (auto-configured by docker-compose)
# ============================================
# DATABASE_URL=postgresql+asyncpg://aikm:aikm@postgres:5432/aikm

# ============================================
# Vector Store (auto-configured by docker-compose)
# ============================================
# QDRANT_URL=http://qdrant:6333

# ============================================
# Cache (auto-configured by docker-compose)
# ============================================
# REDIS_URL=redis://redis:6379

# ============================================
# Knowledge Graph - Neo4j (Phase 3)
# ============================================
# 強密碼：>=16 字元，混合大小寫+數字+符號
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
