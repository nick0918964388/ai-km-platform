# AI-KM Platform Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Security — REQUIRED (no insecure defaults)
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Backend-to-backend API key (if used by internal integrations)
AIKM_API_KEY=

# GitHub self-hosted runner registration token (short-lived ~1h)
# If the runner container is already registered, any non-empty placeholder works.
# For long-lived setup, switch RUNNER_TOKEN → ACCESS_TOKEN with a fine-grained PAT
# (Administration: Read and write) in docker-compose.yml.
GITHUB_RUNNER_TOKEN=

# ============================================
# API Keys (Optional - for enhanced features)
# ============================================
OPENAI_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=

# NVIDIA API — alternative provider for NL→SQL generation (Batch 2-C)
# Enable with SQL_GENERATION_PROVIDER=nvidia (see below)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_SQL_MODEL=minimaxai/minimax-m2.7

# ============================================
# NL→SQL feature flags (Batch 2-B/2-C)
# ============================================
# SQL generation provider: "anthropic" (default) | "nvidia" | "ollama"
SQL_GENERATION_PROVIDER=anthropic
SQL_GENERATION_MODEL=
# Self-reflection retry budget (0 = no retry, 1 = 1 gen + 1 retry, default 1)
NL2SQL_MAX_RETRIES=1
# Skip reflection when rule validator passes + confidence OK
NL2SQL_SKIP_REFLECTION_ON_RULE_PASS=true
# Only retry when LLM confidence < this threshold (default 0.3)
NL2SQL_REFLECTION_CONFIDENCE_THRESHOLD=0.3

# ============================================
# Database (auto-configured by docker-compose)
# ============================================
# DATABASE_URL=postgresql+asyncpg://aikm:aikm@postgres:5432/aikm

# ============================================
# Vector Store (auto-configured by docker-compose)
# ============================================
# QDRANT_URL=http://qdrant:6333

# ============================================
# Cache (auto-configured by docker-compose)
# ============================================
# REDIS_URL=redis://redis:6379

# ============================================
# Knowledge Graph - Neo4j (Phase 3)
# ============================================
# 強密碼：>=16 字元，混合大小寫+數字+符號
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
